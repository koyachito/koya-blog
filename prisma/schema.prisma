generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tags      Tag[]     @relation("PostTags")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  posts     Post[]    @relation("PostTags")
}